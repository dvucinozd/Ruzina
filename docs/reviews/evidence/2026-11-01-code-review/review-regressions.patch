+#[test]
+fn review_failed_seek_must_not_wait_forever_for_new_epoch() {
+    let _lock = crate::DECK_TESTS.lock().unwrap_or_else(|e| e.into_inner());
+    let mut engine = Engine::new();
+    RINGS[0].restart_at(48000, 0);
+    LOADED[0].post(LoadedTrack { ready: true, index: 0, bpm_x100: 12000, track_id: [1;16] });
+    engine.transport();
+    engine.control(&event(SemanticControl::Play, ControlValue::Pressed(true)));
+    engine.apply(DeckEffects::one(DeckEffect::Seek { deck: DeckId::One, position_ms: 1000 }));
+    // Producer::seek's failure path ends the existing epoch. The bridge only logs it.
+    RINGS[0].end();
+    let mut readers = [Reader::new(), Reader::new()];
+    readers[0].sync(&RINGS[0]);
+    for _ in 0..100 { engine.progress(&readers, 128); }
+    assert!(engine.seeking[0].is_none(), "seek never resolves after producer failure");
+}
