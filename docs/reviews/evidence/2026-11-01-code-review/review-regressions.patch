+#[test]
+fn review_seek_to_eof_must_publish_a_new_terminal_epoch() {
+    let (ring, commands) = (ring(), Commands::new());
+    let mut files = Memory::new(&[WAV]);
+    let mut producer = Producer::new();
+    commands.load(0);
+    run(&mut producer, &mut files, ring, &commands);
+    let old_epoch = ring.epoch();
+    commands.seek(250); // the exact end of the 250ms WAV fixture
+    let (_, event) = producer.poll(&mut files, ring, &commands, path);
+    assert!(matches!(event, Some(Event::Seeked { .. })), "{event:?}");
+    assert_ne!(ring.epoch(), old_epoch, "EOF seek produces no completion epoch: {event:?}");
+}
