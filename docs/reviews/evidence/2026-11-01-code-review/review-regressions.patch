+#[test]
+fn review_ring_epoch_metadata_snapshot_is_coherent() {
+    let ring = ring();
+    let writer = std::thread::spawn(move || {
+        for origin in 1..=200_000 {
+            ring.restart_at(48_000, origin);
+        }
+    });
+    let mut reader = Reader::new();
+    let mut mismatch = None;
+    for _ in 0..200_000 {
+        if reader.sync(ring) && reader.position != reader.epoch {
+            mismatch = Some((reader.epoch, reader.position));
+            break;
+        }
+    }
+    writer.join().unwrap();
+    assert_eq!(mismatch, None, "epoch and origin came from different restarts");
+}
