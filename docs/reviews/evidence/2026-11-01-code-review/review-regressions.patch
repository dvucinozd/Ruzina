+// Review-only regressions: appended in an isolated copy, not the working tree.
+#[test]
+fn review_play_after_load_admission_must_preserve_loaded_track() {
+    let _lock = crate::DECK_TESTS.lock().unwrap_or_else(|e| e.into_inner());
+    let mut engine = Engine::new();
+    LOADED[0].post(LoadedTrack { ready: true, index: 0, bpm_x100: 12000, track_id: [1;16] });
+    engine.transport();
+    assert!(engine.load_allowed(DeckId::One));
+    // LOAD was admitted, but PLAY arrives before the producer publishes it.
+    engine.control(&event(SemanticControl::Play, ControlValue::Pressed(true)));
+    assert!(engine.playing()[0]);
+    LOADED[0].post(LoadedTrack { ready: true, index: 1, bpm_x100: 13000, track_id: [2;16] });
+    engine.transport();
+    assert!(engine.loaded[0], "late load completion unloaded the already playing deck");
+}
