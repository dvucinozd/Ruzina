# The deck's Wi-Fi: ESP-Hosted over SDIO slot 1 to the board's ESP32-C6, the deck's own
# access point and the Web Remote. Pins, reset and bus as in Guition's IDF 6.1 demo.
CONFIG_RUZINA_WIFI_REMOTE=y

# Firmware updates from the Web Remote: two 6 MiB app slots, and the bootloader goes back
# to the previous image if a new one restarts before it is kept (ota_slot.c).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n

CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17

# A failed link must not restart the deck, and the hosted console would take over ours.
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_WIFI_AUTO_CONNECT_ON_STA_START=n
# Since 2.12 the SDIO pool takes about 48 KiB of internal DMA RAM in the boot constructor,
# before the 384 KiB startup region joins the heap; on s243 that failed and asserted
# (sdio_drv.c, buf_mp_g). Without the pool each buffer comes from the heap when needed.
CONFIG_ESP_HOSTED_USE_MEMPOOL=n

# lwIP's task on the screen's core, below the decoders: USB audio owns the other one.
CONFIG_LWIP_TCPIP_TASK_PRIO=2
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
