# Pure configure guard shared with the project and offline negative tests.
if(NOT IDF_TARGET STREQUAL "esp32p4")
    message(FATAL_ERROR "This experiment is ESP32-P4 only")
endif()
if(NOT CONFIG_ESP32P4_SELECTS_REV_LESS_V3 OR NOT CONFIG_ESP32P4_REV_MIN_FULL EQUAL 100
        OR NOT CONFIG_ESP32P4_REV_MAX_FULL EQUAL 199)
    message(FATAL_ERROR "Legacy probe requires the separate v1.x memory/ROM profile")
endif()
if(NOT CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ EQUAL 360)
    message(FATAL_ERROR "Keep the initial probe at 360 MHz without PSRAM")
endif()
if(CONFIG_RUZINA_MEMORY_TASK AND CONFIG_RUZINA_DISPLAY_TOUCH)
    message(FATAL_ERROR "Keep diagnostic ownership profiles separate")
endif()
if(CONFIG_RUZINA_SD_READONLY AND (CONFIG_RUZINA_MEMORY_TASK OR CONFIG_RUZINA_DISPLAY_TOUCH OR CONFIG_APP_BUILD_TYPE_PURE_RAM_APP OR CONFIG_SPIRAM))
    message(FATAL_ERROR "Read-only SD requires its own flash-backed owner without PSRAM/display")
endif()
if(CONFIG_RUZINA_SD_FIXTURE AND NOT CONFIG_RUZINA_SD_READONLY)
    message(FATAL_ERROR "File fixture requires the isolated read-only SD owner")
endif()
if(CONFIG_RUZINA_SD_RUST_BRIDGE AND (CONFIG_RUZINA_SD_READONLY OR CONFIG_RUZINA_SD_FIXTURE OR CONFIG_RUZINA_MEMORY_TASK OR CONFIG_RUZINA_DISPLAY_TOUCH OR CONFIG_APP_BUILD_TYPE_PURE_RAM_APP OR (CONFIG_SPIRAM AND NOT CONFIG_RUZINA_SD_RUST_LOAD)))
    message(FATAL_ERROR "Rust SD bridge requires an exclusive flash-backed SD owner without FatFs or the touch diagnostic; PSRAM only for the load profile")
endif()
if(CONFIG_RUZINA_SD_RUST_EXFAT AND NOT CONFIG_RUZINA_SD_RUST_BRIDGE)
    message(FATAL_ERROR "Rust exFAT requires the isolated Rust SD bridge owner")
endif()
if(CONFIG_RUZINA_SD_RUST_LOAD AND (NOT CONFIG_RUZINA_SD_RUST_BRIDGE OR CONFIG_RUZINA_SD_RUST_EXFAT))
    message(FATAL_ERROR "Rust media load requires the Rust SD bridge owner and excludes the fixture run")
endif()
# The deck UI is the one profile that combines owners: Rust SD load, the
# status display with touch and the USB host with MIDI. Otherwise USB host
# stays an isolated, flash-backed owner.
set(ruzina_deck_ui OFF)
if(CONFIG_RUZINA_USB_HOST_MIDI AND CONFIG_RUZINA_SD_RUST_LOAD AND CONFIG_RUZINA_LOAD_DISPLAY)
    set(ruzina_deck_ui ON)
endif()
if(CONFIG_RUZINA_USB_HOST_ENUM AND NOT ruzina_deck_ui AND (CONFIG_RUZINA_SD_READONLY OR CONFIG_RUZINA_SD_RUST_BRIDGE
        OR CONFIG_RUZINA_MEMORY_TASK OR CONFIG_RUZINA_DISPLAY_TOUCH OR CONFIG_RUZINA_LOAD_DISPLAY
        OR CONFIG_APP_BUILD_TYPE_PURE_RAM_APP OR CONFIG_SPIRAM))
    message(FATAL_ERROR "USB host enumeration is an isolated flash-backed owner without SD, display or PSRAM")
endif()
if(ruzina_deck_ui AND (NOT CONFIG_RUZINA_USB_HOST_ENUM OR CONFIG_RUZINA_SD_READONLY OR CONFIG_RUZINA_MEMORY_TASK
        OR CONFIG_RUZINA_DISPLAY_TOUCH OR CONFIG_APP_BUILD_TYPE_PURE_RAM_APP))
    message(FATAL_ERROR "The deck UI combines only Rust SD load, the load display and USB-MIDI")
endif()
if(CONFIG_RUZINA_USB_HOST_UAC AND NOT CONFIG_RUZINA_USB_HOST_MIDI)
    message(FATAL_ERROR "UAC playback requires the USB-MIDI controller owner")
endif()
if(CONFIG_RUZINA_DECK_PLAY AND (NOT CONFIG_RUZINA_USB_HOST_UAC OR NOT ruzina_deck_ui))
    message(FATAL_ERROR "Deck playback requires UAC playback in the deck UI profile")
endif()
if(CONFIG_RUZINA_DECK_ENGINE AND NOT CONFIG_RUZINA_DECK_MIX)
    message(FATAL_ERROR "The deck engine requires the deck mix")
endif()
if(CONFIG_RUZINA_UAC_PROFILE AND (NOT CONFIG_RUZINA_DECK_ENGINE OR CONFIG_FREERTOS_SMP OR CONFIG_ESP_TRACE_ENABLE))
    message(FATAL_ERROR "UAC profiling requires the deck engine and exclusive pinned non-SMP trace hooks")
endif()
if(CONFIG_RUZINA_DECK_MIX AND NOT CONFIG_RUZINA_DECK_PLAY)
    message(FATAL_ERROR "The deck mix requires deck playback")
endif()
if(CONFIG_RUZINA_USB_HOST_MIDI AND NOT CONFIG_RUZINA_USB_HOST_ENUM)
    message(FATAL_ERROR "USB-MIDI requires the USB host diagnostic owner")
endif()
if(CONFIG_RUZINA_LOAD_DISPLAY AND (NOT CONFIG_RUZINA_SD_RUST_LOAD OR CONFIG_RUZINA_DISPLAY_TOUCH))
    message(FATAL_ERROR "Load display requires the Rust media load profile and excludes the touch diagnostic")
endif()
if(CONFIG_RUZINA_MEMORY_TASK OR CONFIG_RUZINA_DISPLAY_TOUCH OR CONFIG_RUZINA_SD_RUST_LOAD)
    if(NOT CONFIG_SPIRAM OR NOT CONFIG_SPIRAM_SPEED EQUAL 80 OR CONFIG_APP_BUILD_TYPE_PURE_RAM_APP
            OR CONFIG_SPIRAM_XIP_FROM_PSRAM OR CONFIG_SPIRAM_FETCH_INSTRUCTIONS OR CONFIG_SPIRAM_RODATA
            OR NOT CONFIG_SPIRAM_USE_CAPS_ALLOC)
        message(FATAL_ERROR "Memory/task requires flash-backed 80MHz caps-only PSRAM without XiP")
    endif()
elseif(CONFIG_SPIRAM)
    message(FATAL_ERROR "Keep the initial probe at 360 MHz without PSRAM")
endif()
if(NOT IDF_VERSION STREQUAL "6.1.0")
    message(FATAL_ERROR "Legacy probe requires IDF 6.1.0")
endif()
