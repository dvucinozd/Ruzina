// The deck screen on the JC1060's 1024 x 600 panel. The layout follows the Overview
// page of the donor firmware (Pajoniiir), with its positions kept in pixels.
//
// The waveforms are not here: Rust draws them directly into the framebuffer, in the
// rectangles left dark below (`slint_ui.rs` keeps the same numbers), because they
// change many times a second and everything else does not.

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 38px;
    background: active ? #10240c : #0d141b;
    border-width: active ? 2px : 1px;
    border-color: active ? #6ee128 : #2f6f8f;
    Text {
        text: root.text;
        color: root.active ? #d8ff8a : #8fd2ee;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A button that reports going down and up, as the controller's buttons do.
component SideButton inherits Rectangle {
    in property <string> text;
    in property <color> ink: #101418;
    callback down(bool);
    width: 58px;
    height: 38px;
    border-radius: 3px;
    opacity: touch.pressed ? 0.6 : 1.0;
    touch := TouchArea {
        changed pressed => { root.down(self.pressed); }
    }
    Text {
        text: root.text;
        color: root.ink;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Deck badge, play and cue, left of a waveform. Rust draws the level meter beside them.
component DeckSide inherits Rectangle {
    in property <int> number;
    in property <color> accent;
    in property <bool> playing;
    callback play();
    callback cue(bool);
    width: 82px;
    height: 201px;
    Rectangle {
        x: 4px;
        y: 12px;
        width: 58px;
        height: 38px;
        border-radius: 3px;
        background: root.accent;
        Text {
            text: "D" + root.number;
            color: #101418;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    SideButton {
        x: 4px;
        y: 60px;
        background: root.playing ? #6ee128 : #e8574c;
        text: root.playing ? "PLAY" : "PAUSE";
        down(pressed) => {
            if (pressed) {
                root.play();
            }
        }
    }
    SideButton {
        x: 4px;
        y: 102px;
        background: #f3c631;
        text: "CUE";
        down(pressed) => { root.cue(pressed); }
    }
}

// Times, tempo, pitch, Master Tempo and key of one deck, above its overview.
component DeckInfo inherits Rectangle {
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> bpm;
    in property <string> pitch;
    in property <bool> master-tempo;
    in property <bool> quantize;
    in property <string> key;
    in property <string> status;
    // MT tapped: Master Tempo on or off.
    callback mt-tapped();
    width: 512px;
    height: 40px;
    Text { x: 8px; y: 2px; text: root.elapsed; color: #eef0f2; font-size: 24px; }
    Text { x: 90px; y: 2px; text: root.remaining; color: #eef0f2; font-size: 24px; }
    Text { x: 190px; y: 2px; text: root.bpm; color: #eef0f2; font-size: 24px; }
    Text { x: 276px; y: 12px; text: "BPM"; color: #9a9ea4; font-size: 12px; }
    Rectangle {
        x: 310px;
        y: 2px;
        width: 76px;
        height: 28px;
        border-width: 2px;
        border-color: #6ee128;
        border-radius: 2px;
        Text {
            text: root.pitch;
            color: #9aff5a;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 394px;
        y: 2px;
        width: 28px;
        height: 28px;
        border-width: 1px;
        border-radius: 4px;
        border-color: root.master-tempo ? #6ee128 : #4a4e54;
        background: root.master-tempo ? #10240c : #181a1d;
        Text {
            text: "MT";
            color: root.master-tempo ? #d8ff8a : #9a9ea4;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // A finger is wider than the box: the tap counts a few pixels around it.
        TouchArea {
            x: -6px;
            y: -2px;
            width: parent.width + 12px;
            height: parent.height + 10px;
            clicked => { root.mt-tapped(); }
        }
    }
    // Quantize: loops and cues land on the beat grid.
    Rectangle {
        x: 426px;
        y: 2px;
        width: 22px;
        height: 28px;
        border-width: 1px;
        border-radius: 4px;
        border-color: root.quantize ? #ff8c00 : #4a4e54;
        background: root.quantize ? #2a1700 : #181a1d;
        Text {
            text: "Q";
            color: root.quantize ? #ffc266 : #9a9ea4;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text { x: 452px; y: 8px; text: root.key; color: #eb870f; font-size: 14px; }
    Text {
        x: 476px;
        y: 9px;
        width: 34px;
        text: root.status;
        color: #9a9ea4;
        font-size: 11px;
        horizontal-alignment: right;
    }
}

// One Hot Cue pad as the Hot Cues page shows it.
export struct CueTile {
    letter: string,
    time: string,
    set: bool,
    tint: color,
}

// One deck's eight Hot Cues, laid out as its pads: A to D above, E to H below. A tap is
// the pad pressed; with DELETE lit it clears the cue, as Shift and the pad do.
component CueDeck inherits Rectangle {
    in property <int> number;
    in property <color> accent;
    in property <string> title;
    in property <bool> loaded;
    in property <[CueTile]> tiles;
    // Pad 0 to 7 down or up, and whether it deletes.
    callback pad(int, bool, bool);
    property <bool> deleting: false;
    width: 512px;
    height: 430px;
    Rectangle {
        x: 10px;
        y: 6px;
        width: 58px;
        height: 34px;
        border-radius: 3px;
        background: root.accent;
        Text {
            text: "D" + root.number;
            color: #101418;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 78px;
        y: 6px;
        width: 300px;
        height: 34px;
        text: root.loaded ? root.title : "NO TRACK";
        color: root.loaded ? #eef0f2 : #9a9ea4;
        font-size: 15px;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        x: 392px;
        y: 6px;
        width: 110px;
        height: 34px;
        border-radius: 3px;
        border-width: 1px;
        border-color: #e8574c;
        background: root.deleting ? #e8574c : #181a1d;
        Text {
            text: "DELETE";
            color: root.deleting ? #101418 : #e8574c;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.loaded;
            clicked => { root.deleting = !root.deleting; }
        }
    }
    for tile[i] in root.tiles: Rectangle {
        x: 10px + Math.mod(i, 4) * 124px;
        y: 52px + Math.floor(i / 4) * 188px;
        width: 116px;
        height: 180px;
        border-radius: 4px;
        border-width: root.deleting && tile.set ? 4px : 2px;
        border-color: root.deleting && tile.set ? #e8574c : tile.tint;
        background: tile.set ? tile.tint : #14181c;
        opacity: !root.loaded ? 0.4 : touch.pressed ? 0.6 : 1.0;
        Text {
            y: 24px;
            width: parent.width;
            text: tile.letter;
            color: tile.set ? #101418 : tile.tint;
            font-size: 44px;
            horizontal-alignment: center;
        }
        Text {
            y: 120px;
            width: parent.width;
            text: tile.time;
            color: tile.set ? #101418 : #9a9ea4;
            font-size: tile.set ? 20px : 13px;
            horizontal-alignment: center;
        }
        touch := TouchArea {
            enabled: root.loaded;
            // DELETE goes out with the press that deletes: by the release the cue may
            // already be gone from the tile.
            changed pressed => {
                if (self.pressed) {
                    root.pad(i, true, root.deleting);
                    if (root.deleting && tile.set) {
                        root.deleting = false;
                    }
                } else {
                    root.pad(i, false, false);
                }
            }
        }
    }
}

// One figure on the Settings page.
export struct SettingLine {
    label: string,
    value: string,
}

// What the deck reports about itself: the decks' audio, the mix and the firmware.
component SettingsPage inherits Rectangle {
    in property <[SettingLine]> left;
    in property <[SettingLine]> right;
    width: 1024px;
    height: 430px;
    background: #0d0f11;
    // Takes the taps, away from the page below.
    TouchArea { }
    Text { x: 24px; y: 10px; text: "DECKS"; color: #8fd2ee; font-size: 16px; }
    Text { x: 536px; y: 10px; text: "MIX AND SYSTEM"; color: #8fd2ee; font-size: 16px; }
    for line[i] in root.left: Rectangle {
        x: 16px;
        y: 40px + i * 34px;
        width: 488px;
        height: 32px;
        background: Math.mod(i, 2) == 0 ? #12161a : #0f1215;
        Text { x: 8px; width: 220px; text: line.label; color: #9a9ea4; font-size: 15px; vertical-alignment: center; }
        Text { x: 230px; width: 250px; text: line.value; color: #eef0f2; font-size: 16px; overflow: elide; vertical-alignment: center; }
    }
    for line[i] in root.right: Rectangle {
        x: 520px;
        y: 40px + i * 34px;
        width: 488px;
        height: 32px;
        background: Math.mod(i, 2) == 0 ? #12161a : #0f1215;
        Text { x: 8px; width: 160px; text: line.label; color: #9a9ea4; font-size: 15px; vertical-alignment: center; }
        Text { x: 170px; width: 310px; text: line.value; color: #eef0f2; font-size: 16px; overflow: elide; vertical-alignment: center; }
    }
}

// One row of the Library page.
export struct LibraryLine {
    number: string,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    time: string,
    decks: string,
    selected: bool,
}

// The catalog, a page at a time around the selection, which the browse knob or a tap
// moves. LOAD on the controller or here loads the selected track.
component LibraryPage inherits Rectangle {
    in property <[LibraryLine]> rows;
    in property <string> count;
    callback pick(int);
    callback load(int);
    width: 1024px;
    height: 430px;
    background: #0d0f11;
    // Takes the taps that miss the rows and buttons, away from the page below.
    TouchArea { }
    Text { x: 8px; y: 6px; text: "#"; color: #9a9ea4; font-size: 11px; }
    Text { x: 48px; y: 6px; text: "TITLE"; color: #9a9ea4; font-size: 11px; }
    Text { x: 470px; y: 6px; text: "ARTIST"; color: #9a9ea4; font-size: 11px; }
    Text { x: 700px; y: 6px; text: "BPM"; color: #9a9ea4; font-size: 11px; }
    Text { x: 770px; y: 6px; text: "KEY"; color: #9a9ea4; font-size: 11px; }
    Text { x: 820px; y: 6px; text: "TIME"; color: #9a9ea4; font-size: 11px; }
    for row[i] in root.rows: Rectangle {
        x: 0px;
        y: 26px + i * 33px;
        width: 900px;
        height: 32px;
        background: row.selected ? #10240c : #12161a;
        border-width: row.selected ? 1px : 0px;
        border-color: #6ee128;
        Text {
            x: 8px;
            width: 36px;
            text: row.number;
            color: #9a9ea4;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            x: 48px;
            width: 412px;
            text: row.title;
            color: row.selected ? #d8ff8a : #eef0f2;
            font-size: 15px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 470px;
            width: 222px;
            text: row.artist;
            color: #c6cad0;
            font-size: 14px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text { x: 700px; width: 64px; text: row.bpm; color: #eef0f2; font-size: 14px; vertical-alignment: center; }
        Text { x: 770px; width: 46px; text: row.key; color: #eb870f; font-size: 14px; vertical-alignment: center; }
        Text { x: 820px; width: 46px; text: row.time; color: #eef0f2; font-size: 14px; vertical-alignment: center; }
        Text { x: 866px; width: 32px; text: row.decks; color: #38d6f0; font-size: 11px; vertical-alignment: center; }
        TouchArea {
            clicked => { root.pick(i); }
        }
    }
    for deck[i] in [1, 2]: Rectangle {
        x: 912px;
        y: 40px + i * 96px;
        width: 104px;
        height: 84px;
        border-radius: 4px;
        background: i == 0 ? #38d6f0 : #6ee1a8;
        opacity: load.pressed ? 0.6 : 1.0;
        Text {
            text: "LOAD\nD" + deck;
            color: #101418;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        load := TouchArea {
            clicked => { root.load(i); }
        }
    }
    Text {
        x: 912px;
        y: 400px;
        width: 104px;
        text: root.count;
        color: #9a9ea4;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

// A choice on the FX page, lit while it is the one in use.
component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 56px;
    border-radius: 4px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? #8fd2ee : #2f6f8f;
    background: root.selected ? #2a6fa8 : #12161a;
    opacity: touch.pressed ? 0.6 : 1.0;
    Text {
        text: root.text;
        color: root.selected ? #ffffff : #c6cad0;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Beat FX by touch: the effect, its beat and channel, the depth, and FX ON. Each choice
// does what the controller's Beat FX buttons and knob do.
component FxPage inherits Rectangle {
    in property <string> effect;
    in property <string> beat;
    in property <int> depth;
    in property <int> target;
    in property <bool> on;
    // What changed (0 effect, 1 beat, 2 channel, 3 depth from 0 to 127, 4 FX ON) and to.
    callback set(int, float);
    callback close();
    width: 1024px;
    height: 430px;
    background: #0d0f11;
    // Takes the taps that miss the buttons, away from the page below.
    TouchArea { }
    Text { x: 16px; y: 12px; text: "BEAT FX"; color: #eef0f2; font-size: 20px; }
    Text { x: 16px; y: 54px; text: "EFFECT"; color: #9a9ea4; font-size: 12px; }
    for name[i] in ["FILTER", "ECHO", "FLANGER", "DELAY"]: Choice {
        x: 16px + i * 198px;
        y: 72px;
        width: 190px;
        text: name;
        selected: name == root.effect;
        clicked => { root.set(0, i); }
    }
    Text { x: 16px; y: 140px; text: "BEAT"; color: #9a9ea4; font-size: 12px; }
    for name[i] in ["1/4", "1/2", "1", "2", "4"]: Choice {
        x: 16px + i * 158px;
        y: 158px;
        width: 150px;
        text: name;
        selected: name == root.beat;
        clicked => { root.set(1, i); }
    }
    Text { x: 16px; y: 226px; text: "CHANNEL"; color: #9a9ea4; font-size: 12px; }
    for name[i] in ["DECK 1", "DECK 2", "BOTH"]: Choice {
        x: 16px + i * 198px;
        y: 244px;
        width: 190px;
        text: name;
        // Deck 1, deck 2 and both are channels 1, 2 and 0.
        selected: Math.mod(i + 1, 3) == root.target;
        clicked => { root.set(2, Math.mod(i + 1, 3)); }
    }
    Text { x: 16px; y: 312px; text: "DEPTH"; color: #9a9ea4; font-size: 12px; }
    Rectangle {
        x: 16px;
        y: 330px;
        width: 700px;
        height: 64px;
        border-radius: 4px;
        border-width: 1px;
        border-color: #2f6f8f;
        background: #12161a;
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * root.depth / 100;
            height: parent.height - 2px;
            border-radius: 3px;
            background: #2a6fa8;
        }
        // Down on the bar and dragged along it, as the depth knob turns.
        slide := TouchArea {
            changed pressed => {
                if (self.pressed) {
                    root.set(3, max(0, min(1, self.mouse-x / self.width)) * 127);
                }
            }
            moved => { root.set(3, max(0, min(1, self.mouse-x / self.width)) * 127); }
        }
    }
    Text {
        x: 724px;
        y: 330px;
        width: 76px;
        height: 64px;
        text: root.depth + "%";
        color: #eef0f2;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Choice {
        x: 824px;
        y: 8px;
        width: 184px;
        height: 48px;
        text: "CLOSE";
        selected: false;
        clicked => { root.close(); }
    }
    Rectangle {
        x: 824px;
        y: 72px;
        width: 184px;
        height: 322px;
        border-radius: 6px;
        border-width: 2px;
        border-color: #6ee128;
        background: root.on ? #6ee128 : #181a1d;
        opacity: toggle.pressed ? 0.6 : 1.0;
        Text {
            text: root.on ? "FX ON" : "FX OFF";
            color: root.on ? #101418 : #6ee128;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        toggle := TouchArea {
            clicked => { root.set(4, 0); }
        }
    }
}

// The Beat FX at a glance, right of the lanes; a tap opens the FX page.
component FxPanel inherits Rectangle {
    in property <string> effect;
    in property <string> beat;
    in property <int> depth;
    in property <int> target;
    in property <bool> on;
    callback open();
    width: 64px;
    height: 428px;
    background: #0d141b;
    border-width: 1px;
    border-color: #2f6f8f;
    TouchArea {
        clicked => { root.open(); }
    }
    Rectangle {
        x: 4px;
        y: 4px;
        width: 56px;
        height: 22px;
        background: root.on ? #2a6fa8 : #1c2228;
        Text { text: "FX"; color: #eef0f2; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: 4px;
        y: 30px;
        width: 56px;
        height: 34px;
        border-width: 1px;
        border-color: #8fd2ee;
        Text { text: root.effect; color: #eef0f2; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 68px; width: 64px; text: "TARGET"; color: #9a9ea4; font-size: 11px; horizontal-alignment: center; }
    for pill in 2: Rectangle {
        x: 5px + pill * 29px;
        y: 84px;
        width: 25px;
        height: 22px;
        border-radius: 11px;
        border-width: 1px;
        border-color: #8fd2ee;
        background: root.target == 0 || root.target == pill + 1 ? #2a6fa8 : #0d141b;
        Text { text: pill + 1; color: #eef0f2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 112px; width: 64px; text: "BEAT"; color: #9a9ea4; font-size: 11px; horizontal-alignment: center; }
    Rectangle {
        x: 12px;
        y: 128px;
        width: 40px;
        height: 26px;
        border-width: 1px;
        border-color: #8fd2ee;
        Text { text: root.beat; color: #eef0f2; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 160px; width: 64px; text: "DEPTH"; color: #9a9ea4; font-size: 11px; horizontal-alignment: center; }
    Rectangle {
        x: 22px;
        y: 176px;
        width: 20px;
        height: 216px;
        border-width: 1px;
        border-color: #4a4e54;
        Rectangle {
            x: 1px;
            y: parent.height - 1px - self.height;
            width: 18px;
            height: (parent.height - 2px) * root.depth / 100;
            background: #2a6fa8;
        }
    }
    Text { x: 0px; y: 398px; width: 64px; text: root.depth + "%"; color: #eef0f2; font-size: 14px; horizontal-alignment: center; }
}

export component Overview inherits Window {
    width: 1024px;
    height: 600px;
    default-font-family: "DejaVu Sans";
    background: #0d0f11;
    in property <string> title-1;
    in property <string> title-2;
    in property <string> elapsed-1;
    in property <string> elapsed-2;
    in property <string> remaining-1;
    in property <string> remaining-2;
    in property <string> bpm-1;
    in property <string> bpm-2;
    in property <string> pitch-1;
    in property <string> pitch-2;
    in property <string> key-1;
    in property <string> key-2;
    in property <string> status-1;
    in property <string> status-2;
    in property <bool> master-tempo-1;
    in property <bool> master-tempo-2;
    in property <bool> quantize-1;
    in property <bool> quantize-2;
    in property <bool> playing-1;
    in property <bool> playing-2;
    in property <string> fx-effect;
    in property <string> fx-beat;
    in property <int> fx-depth;
    in property <int> fx-target;
    in property <bool> fx-on;

    in property <[LibraryLine]> library-rows;
    in property <string> library-count;
    in property <[CueTile]> cues-1;
    in property <[CueTile]> cues-2;
    in property <bool> loaded-1;
    in property <bool> loaded-2;
    in property <[SettingLine]> settings-left;
    in property <[SettingLine]> settings-right;

    // Deck 0 or 1: PLAY pressed, CUE down or up.
    callback play(int);
    callback cue(int, bool);
    // The Library: a row of the page tapped, LOAD tapped for deck 0 or 1.
    callback pick(int);
    callback load(int);
    // The Hot Cues page: deck 0 or 1, its pad 0 to 7 down or up, and whether it deletes.
    callback hot-cue(int, int, bool, bool);
    // The FX page: what changed (0 effect, 1 beat, 2 channel, 3 depth, 4 FX ON) and to.
    callback fx(int, float);
    // MT tapped on deck 0 or 1.
    callback master-tempo(int);
    // Each tab has a page. The FX panel opens page 4, which no tab marks.
    in-out property <int> active-tab: 0;

    for name[index] in ["OVERVIEW", "LIBRARY", "HOT CUES", "SETTINGS"]: Tab {
        x: 8px + index * 253px;
        y: 4px;
        width: 248px;
        text: name;
        active: index == root.active-tab;
        clicked => { root.active-tab = index; }
    }

    DeckSide {
        x: 0px;
        y: 46px;
        number: 1;
        accent: #38d6f0;
        playing: root.playing-1;
        play => { root.play(0); }
        cue(down) => { root.cue(0, down); }
    }
    DeckSide {
        x: 0px;
        y: 248px;
        number: 2;
        accent: #6ee1a8;
        playing: root.playing-2;
        play => { root.play(1); }
        cue(down) => { root.cue(1, down); }
    }
    // Rust draws here: the two waveforms.
    Rectangle { x: 82px; y: 46px; width: 872px; height: 201px; background: #020406; }
    Rectangle { x: 82px; y: 248px; width: 872px; height: 201px; background: #020406; }

    FxPanel {
        x: 960px;
        y: 46px;
        effect: root.fx-effect;
        beat: root.fx-beat;
        depth: root.fx-depth;
        target: root.fx-target;
        on: root.fx-on;
        open => { root.active-tab = 4; }
    }

    // Made once and kept: opening the page then only draws it.
    LibraryPage {
        visible: root.active-tab == 1;
        x: 0px;
        y: 46px;
        rows: root.library-rows;
        count: root.library-count;
        pick(row) => { root.pick(row); }
        load(deck) => { root.load(deck); }
    }

    if root.active-tab == 4: FxPage {
        x: 0px;
        y: 46px;
        effect: root.fx-effect;
        beat: root.fx-beat;
        depth: root.fx-depth;
        target: root.fx-target;
        on: root.fx-on;
        set(kind, value) => { root.fx(kind, value); }
        close => { root.active-tab = 0; }
    }

    if root.active-tab == 3: SettingsPage {
        x: 0px;
        y: 46px;
        left: root.settings-left;
        right: root.settings-right;
    }

    if root.active-tab == 2: Rectangle {
        x: 0px;
        y: 46px;
        width: 1024px;
        height: 430px;
        background: #0d0f11;
        // Takes the taps that miss the pads and buttons, away from the page below.
        TouchArea { }
        CueDeck {
            x: 0px;
            number: 1;
            accent: #38d6f0;
            title: root.title-1;
            loaded: root.loaded-1;
            tiles: root.cues-1;
            pad(pad, down, delete) => { root.hot-cue(0, pad, down, delete); }
        }
        Rectangle { x: 511px; y: 8px; width: 2px; height: 414px; background: #2f6f8f; }
        CueDeck {
            x: 512px;
            number: 2;
            accent: #6ee1a8;
            title: root.title-2;
            loaded: root.loaded-2;
            tiles: root.cues-2;
            pad(pad, down, delete) => { root.hot-cue(1, pad, down, delete); }
        }
    }

    // Track titles, across the screen: deck 1 from the left, deck 2 to the right.
    Rectangle {
        x: 0px;
        y: 478px;
        width: 1024px;
        height: 30px;
        background: #1565c0;
        Text {
            x: 8px;
            width: 500px;
            text: root.title-1;
            color: #ffffff;
            font-size: 20px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 516px;
            width: 500px;
            text: root.title-2;
            color: #ffffff;
            font-size: 20px;
            overflow: elide;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    DeckInfo {
        x: 0px;
        y: 510px;
        elapsed: root.elapsed-1;
        remaining: root.remaining-1;
        bpm: root.bpm-1;
        pitch: root.pitch-1;
        master-tempo: root.master-tempo-1;
        quantize: root.quantize-1;
        key: root.key-1;
        status: root.status-1;
        mt-tapped => { root.master-tempo(0); }
    }
    DeckInfo {
        x: 512px;
        y: 510px;
        elapsed: root.elapsed-2;
        remaining: root.remaining-2;
        bpm: root.bpm-2;
        pitch: root.pitch-2;
        master-tempo: root.master-tempo-2;
        quantize: root.quantize-2;
        key: root.key-2;
        status: root.status-2;
        mt-tapped => { root.master-tempo(1); }
    }
    // Rust draws here: the two overviews.
    Rectangle { x: 8px; y: 552px; width: 496px; height: 45px; background: #020406; }
    Rectangle { x: 520px; y: 552px; width: 496px; height: 45px; background: #020406; }

    // Track titles and artists use more than ASCII. The software renderer only has
    // the glyphs it embedded at build time: ASCII, plus every character in a string
    // literal. This invisible text puts Latin-1, Latin Extended-A (with the Croatian
    // letters) and typographic quotes and dashes into every embedded size.
    Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        color: transparent;
        text: "¡¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĨĩĪīĬĭĮįİıĲĳĴĵĶķĸĹĺĻļĽľĿŀŁłŃńŅņŇňŉŊŋŌōŎŏŐőŒœŔŕŖŗŘřŚśŜŝŞşŠšŢţŤťŦŧŨũŪūŬŭŮůŰűŲųŴŵŶŷŸŹźŻżŽžſ‘’‚“”„–—•€™";
    }
}
