// The deck screen on the JC1060's 1024 x 600 panel. The layout follows the donor
// firmware's (Pajoniiir) ui-next Perform page: the pages on an icon rail at the left, the
// two lanes with the phase strip between them, and the deck cards at the bottom.
//
// The waveforms are not here: Rust draws them directly into the framebuffer, in the
// rectangles left dark below (`slint_ui.rs` keeps the same numbers), because they
// change many times a second and everything else does not.

// A page on the rail at the left: its icon only, lit while the page is open.
component RailButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 48px;
    height: 120px;
    background: root.active ? #2a1b14 : transparent;
    if root.active: Rectangle {
        x: 0px;
        y: 18px;
        width: 3px;
        height: parent.height - 36px;
        background: #e64c0c;
    }
    Image {
        x: (parent.width - 26px) / 2;
        y: (parent.height - 26px) / 2;
        width: 26px;
        height: 26px;
        source: root.icon;
        colorize: root.active ? #e64c0c : #a3958e;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A button that reports going down and up, as the controller's buttons do. Lit, it is
// filled with its tint; otherwise only its outline and text are, and it fills while it
// is held down.
component SideButton inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> lit;
    callback down(bool);
    property <bool> filled: root.lit || touch.pressed;
    width: 58px;
    height: 50px;
    border-radius: 4px;
    border-width: 2px;
    border-color: root.tint;
    background: root.filled ? root.tint : #000000;
    touch := TouchArea {
        changed pressed => { root.down(self.pressed); }
    }
    Text {
        text: root.text;
        color: root.filled ? #100c08 : root.tint;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Deck badge, play and cue, left of a waveform. Rust draws the level meter beside them.
component DeckSide inherits Rectangle {
    in property <int> number;
    in property <color> accent;
    in property <bool> playing;
    // The loaded track's cover, under CUE; nothing without one.
    in property <image> cover;
    in property <bool> has-cover;
    callback play();
    callback cue(bool);
    width: 66px;
    height: 200px;
    Rectangle {
        x: 4px;
        y: 4px;
        width: 58px;
        height: 26px;
        border-radius: 3px;
        background: root.accent;
        Text {
            text: "D" + root.number;
            color: #100c08;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // Green: filled while the deck plays, an outline while it stands.
    SideButton {
        x: 4px;
        y: 34px;
        tint: #00ff66;
        lit: root.playing;
        text: root.playing ? "PLAY" : "PAUSE";
        down(pressed) => {
            if (pressed) {
                root.play();
            }
        }
    }
    // Yellow: an outline, filled while it is held.
    SideButton {
        x: 4px;
        y: 88px;
        tint: #ffd600;
        text: "CUE";
        down(pressed) => { root.cue(pressed); }
    }
    // As wide as the buttons above it.
    if root.has-cover: Image {
        x: 4px;
        y: 142px;
        width: 58px;
        height: 58px;
        source: root.cover;
    }
}

// Times, tempo, pitch and Master Tempo of one deck, above its overview. The time left
// and the tempo are the large ones; in a track's last 30 s the time left blinks red.
component DeckInfo inherits Rectangle {
    in property <string> elapsed;
    in property <string> remaining;
    in property <bool> ending;
    in property <bool> blink;
    in property <string> bpm;
    in property <string> pitch;
    in property <bool> master-tempo;
    in property <bool> quantize;
    // MT tapped: Master Tempo on or off.
    callback mt-tapped();
    width: 466px;
    height: 34px;
    Text { x: 0px; height: 34px; text: root.elapsed; color: #f5f0ed; font-size: 18px; vertical-alignment: center; }
    Text {
        x: 66px;
        height: 34px;
        text: root.remaining;
        color: !root.ending ? #a3958e : root.blink ? #ff0033 : #5c1020;
        font-size: 26px;
        vertical-alignment: center;
    }
    Text { x: 176px; height: 34px; text: root.bpm; color: #e64c0c; font-size: 26px; vertical-alignment: center; }
    Text { x: 264px; y: 17px; text: "BPM"; color: #a3958e; font-size: 10px; }
    Rectangle {
        x: 300px;
        y: 3px;
        width: 66px;
        height: 28px;
        border-width: 2px;
        border-color: #ffd600;
        border-radius: 2px;
        Text {
            text: root.pitch;
            color: #ffd600;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // MT and Q: large enough to read and to hit (the owner asked, 2026-11-26).
    Rectangle {
        x: 374px;
        y: 0px;
        width: 44px;
        height: 34px;
        border-width: root.master-tempo ? 2px : 1px;
        border-radius: 4px;
        border-color: root.master-tempo ? #00ff66 : #574b45;
        background: root.master-tempo ? #0b2614 : #000000;
        Text {
            text: "MT";
            color: root.master-tempo ? #00ff66 : #a3958e;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // A finger is wider than the box: the tap counts a few pixels around it.
        TouchArea {
            x: -6px;
            y: -2px;
            width: parent.width + 12px;
            height: parent.height + 10px;
            clicked => { root.mt-tapped(); }
        }
    }
    // Quantize: loops and cues land on the beat grid.
    Rectangle {
        x: 422px;
        y: 0px;
        width: 44px;
        height: 34px;
        border-width: root.quantize ? 2px : 1px;
        border-radius: 4px;
        border-color: root.quantize ? #ffd600 : #574b45;
        background: root.quantize ? #2a2300 : #000000;
        Text {
            text: "Q";
            color: root.quantize ? #ffd600 : #a3958e;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A small label beside a deck's title: its key, or its state (SYNC, LOOP, EMPTY).
component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 22px;
    border-width: 1px;
    border-radius: 4px;
    border-color: root.tint;
    background: #000000;
    Text {
        text: root.text;
        color: root.tint;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One Hot Cue pad as the Hot Cues page shows it.
export struct CueTile {
    letter: string,
    time: string,
    set: bool,
    tint: color,
}

// One Rekordbox memory cue as the Hot Cues page lists it.
export struct MemoryLine {
    number: string,
    time: string,
    looped: bool,
}

// One deck's eight Hot Cues, laid out as its pads: A to D above, E to H below. A tap is
// the pad pressed; with DELETE lit it clears the cue, as Shift and the pad do. MEMORY
// lists the track's memory cues instead, two columns of eight: a tap calls one, as the
// SAMPLER pads do.
component CueDeck inherits Rectangle {
    in property <int> number;
    in property <color> accent;
    in property <string> title;
    in property <bool> loaded;
    in property <[CueTile]> tiles;
    in property <[MemoryLine]> memory;
    // Pad 0 to 7 down or up, and whether it deletes.
    callback pad(int, bool, bool);
    // Memory cue 0 to 15 tapped.
    callback call(int);
    property <bool> deleting: false;
    property <bool> listing: false;
    width: 476px;
    height: 474px;
    Rectangle {
        x: 10px;
        y: 6px;
        width: 58px;
        height: 34px;
        border-radius: 3px;
        background: root.accent;
        Text {
            text: "D" + root.number;
            color: #100c08;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 76px;
        y: 6px;
        width: 166px;
        height: 34px;
        text: root.loaded ? root.title : "NO TRACK";
        color: root.loaded ? #f5f0ed : #a3958e;
        font-size: 15px;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        x: 250px;
        y: 6px;
        width: 104px;
        height: 34px;
        border-radius: 3px;
        border-width: 1px;
        border-color: #f5f0ed;
        background: root.listing ? #f5f0ed : #000000;
        Text {
            text: "MEMORY";
            color: root.listing ? #100c08 : #f5f0ed;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => {
                root.listing = !root.listing;
                root.deleting = false;
            }
        }
    }
    if !root.listing: Rectangle {
        x: 362px;
        y: 6px;
        width: 104px;
        height: 34px;
        border-radius: 3px;
        border-width: 1px;
        border-color: #ff2e63;
        background: root.deleting ? #ff2e63 : #000000;
        Text {
            text: "DELETE";
            color: root.deleting ? #100c08 : #ff2e63;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            enabled: root.loaded;
            clicked => { root.deleting = !root.deleting; }
        }
    }
    if root.listing && root.memory.length == 0: Text {
        x: 10px;
        y: 52px;
        width: 456px;
        height: 410px;
        text: root.loaded ? "NO MEMORY CUES" : "NO TRACK";
        color: #a3958e;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for line[i] in root.memory: Rectangle {
        visible: root.listing;
        x: 10px + Math.floor(i / 8) * 232px;
        y: 52px + Math.mod(i, 8) * 50px;
        width: 224px;
        height: 40px;
        border-radius: 4px;
        border-width: 1px;
        border-color: #f5f0ed;
        background: #000000;
        opacity: memory-touch.pressed ? 0.6 : 1.0;
        Text {
            x: 10px;
            width: 40px;
            text: line.number;
            color: #f5f0ed;
            font-size: 18px;
            vertical-alignment: center;
        }
        Text {
            x: 54px;
            width: 110px;
            text: line.time;
            color: #f5f0ed;
            font-size: 18px;
            vertical-alignment: center;
        }
        if line.looped: Text {
            x: 170px;
            width: 60px;
            text: "LOOP";
            color: #ff7700;
            font-size: 14px;
            vertical-alignment: center;
        }
        memory-touch := TouchArea {
            clicked => { root.call(i); }
        }
    }
    for tile[i] in root.tiles: Rectangle {
        visible: !root.listing;
        x: 10px + Math.mod(i, 4) * 116px;
        y: 52px + Math.floor(i / 4) * 210px;
        width: 108px;
        height: 200px;
        border-radius: 4px;
        border-width: root.deleting && tile.set ? 4px : 2px;
        border-color: root.deleting && tile.set ? #ff2e63 : tile.tint;
        background: tile.set ? tile.tint : #000000;
        opacity: !root.loaded ? 0.4 : touch.pressed ? 0.6 : 1.0;
        Text {
            y: 30px;
            width: parent.width;
            text: tile.letter;
            color: tile.set ? #100c08 : tile.tint;
            font-size: 44px;
            horizontal-alignment: center;
        }
        Text {
            y: 136px;
            width: parent.width;
            text: tile.time;
            color: tile.set ? #100c08 : #a3958e;
            font-size: tile.set ? 20px : 13px;
            horizontal-alignment: center;
        }
        touch := TouchArea {
            enabled: root.loaded;
            // DELETE goes out with the press that deletes: by the release the cue may
            // already be gone from the tile.
            changed pressed => {
                if (self.pressed) {
                    root.pad(i, true, root.deleting);
                    if (root.deleting && tile.set) {
                        root.deleting = false;
                    }
                } else {
                    root.pad(i, false, false);
                }
            }
        }
    }
}

// One figure on the Settings page.
export struct SettingLine {
    label: string,
    value: string,
}

// A choice on the FX and Settings pages, lit while it is the one in use.
component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 56px;
    border-radius: 4px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? #e64c0c : #38251e;
    background: root.selected ? #b7410e : #1e1511;
    opacity: touch.pressed ? 0.6 : 1.0;
    Text {
        text: root.text;
        color: root.selected ? #f5f0ed : #f5f0ed;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One setting: its name, and its choices to the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    x: 12px;
    width: 460px;
    height: 48px;
    background: #000000;
    Text { x: 8px; width: 140px; text: root.label; color: #a3958e; font-size: 15px; vertical-alignment: center; }
}

// What the deck reports about itself (the decks' audio, the mix and the firmware), and
// the settings it keeps on flash.
component SettingsPage inherits Rectangle {
    in property <[SettingLine]> left;
    in property <[SettingLine]> right;
    in property <bool> load-lock;
    in property <bool> jog-cdj-1;
    in property <bool> jog-cdj-2;
    in property <int> backlight;
    in property <int> trim;
    in property <int> screensaver;
    // Whether the deck has its own network, whose password DEFAULT puts back.
    in property <bool> wifi;
    // What changed (0 LOAD LOCK, 1 deck 1's jog, 2 deck 2's jog, 3 the brightness one
    // step, 4 the MAIN trim, 5 the screensaver, 6 the network's password back to the
    // default) and to: 1 for on, CDJ or a step up, else 0; the trim 0 to 2; the
    // screensaver 0 OFF, then 1 to 3 for 2, 5 and 10 minutes.
    callback change(int, int);
    width: 952px;
    height: 474px;
    background: #000000;
    // Takes the taps that miss the buttons, away from the page below.
    TouchArea { }
    Text { x: 20px; y: 10px; text: "DECKS"; color: #e64c0c; font-size: 16px; }
    Text { x: 492px; y: 10px; text: "MIX AND SYSTEM"; color: #e64c0c; font-size: 16px; }
    Text { x: 20px; y: 150px; text: "SETTINGS"; color: #e64c0c; font-size: 16px; }
    SettingRow {
        y: 176px;
        label: "LOAD LOCK";
        Choice { x: 150px; y: 4px; width: 150px; height: 40px; text: "ON"; selected: root.load-lock; clicked => { root.change(0, 1); } }
        Choice { x: 306px; y: 4px; width: 150px; height: 40px; text: "OFF"; selected: !root.load-lock; clicked => { root.change(0, 0); } }
    }
    SettingRow {
        y: 226px;
        label: "JOG DECK 1";
        Choice { x: 150px; y: 4px; width: 150px; height: 40px; text: "VINYL"; selected: !root.jog-cdj-1; clicked => { root.change(1, 0); } }
        Choice { x: 306px; y: 4px; width: 150px; height: 40px; text: "CDJ"; selected: root.jog-cdj-1; clicked => { root.change(1, 1); } }
    }
    SettingRow {
        y: 276px;
        label: "JOG DECK 2";
        Choice { x: 150px; y: 4px; width: 150px; height: 40px; text: "VINYL"; selected: !root.jog-cdj-2; clicked => { root.change(2, 0); } }
        Choice { x: 306px; y: 4px; width: 150px; height: 40px; text: "CDJ"; selected: root.jog-cdj-2; clicked => { root.change(2, 1); } }
    }
    SettingRow {
        y: 326px;
        label: "BRIGHTNESS";
        Choice { x: 150px; y: 4px; width: 90px; height: 40px; text: "-"; clicked => { root.change(3, 0); } }
        Text { x: 240px; width: 126px; height: 48px; text: root.backlight + " %"; color: #f5f0ed; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        Choice { x: 366px; y: 4px; width: 90px; height: 40px; text: "+"; clicked => { root.change(3, 1); } }
    }
    SettingRow {
        y: 376px;
        label: "MAIN TRIM";
        for name[i] in ["0 dB", "-3 dB", "-6 dB"]: Choice {
            x: 150px + i * 104px;
            y: 4px;
            width: 98px;
            height: 40px;
            text: name;
            selected: i == root.trim;
            clicked => { root.change(4, i); }
        }
    }
    // Under the ten lines of the right column.
    SettingRow {
        x: 480px;
        y: 382px;
        height: 44px;
        label: "SCREENSAVER";
        for name[i] in ["OFF", "2 MIN", "5 MIN", "10 MIN"]: Choice {
            x: 150px + i * 78px;
            y: 4px;
            width: 72px;
            height: 36px;
            text: name;
            selected: i == root.screensaver;
            clicked => { root.change(5, i); }
        }
    }
    // Under the screensaver: the network's password set from the Web Remote, back to the
    // default shown above.
    if root.wifi: SettingRow {
        x: 480px;
        y: 428px;
        height: 42px;
        label: "WI-FI PASSWORD";
        Choice { x: 306px; y: 3px; width: 150px; height: 36px; text: "DEFAULT"; clicked => { root.change(6, 0); } }
    }
    for line[i] in root.left: Rectangle {
        x: 12px;
        y: 40px + i * 34px;
        width: 460px;
        height: 32px;
        background: Math.mod(i, 2) == 0 ? #000000 : #101010;
        Text { x: 8px; width: 90px; text: line.label; color: #a3958e; font-size: 15px; vertical-alignment: center; }
        Text { x: 100px; width: 352px; text: line.value; color: #f5f0ed; font-size: 16px; overflow: elide; vertical-alignment: center; }
    }
    for line[i] in root.right: Rectangle {
        x: 480px;
        y: 40px + i * 34px;
        width: 460px;
        height: 32px;
        background: Math.mod(i, 2) == 0 ? #000000 : #101010;
        Text { x: 8px; width: 160px; text: line.label; color: #a3958e; font-size: 15px; vertical-alignment: center; }
        Text { x: 170px; width: 282px; text: line.value; color: #f5f0ed; font-size: 16px; overflow: elide; vertical-alignment: center; }
    }
}

// One row of the Library page.
export struct LibraryLine {
    number: string,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    time: string,
    decks: string,
    selected: bool,
    // 0 a track, 1 a folder, 2 a playlist.
    kind: int,
    // How its key sits with the reference deck's: 0 no reference, 1 fits, 2 two steps
    // up, 3 seven steps up, 4 none of these.
    fit: int,
}

// The catalog or a level of its playlists, a page at a time around the selection, which
// the browse knob or a tap moves. LOAD on the controller or here loads the selected
// track; on a folder or playlist it opens it, as the knob's press or a second tap does.
// PLAYLIST goes to the playlists' top level, and from there back to the tracks; Shift
// and the press go one level up.
component LibraryPage inherits Rectangle {
    in property <[LibraryLine]> rows;
    in property <string> count;
    in property <string> heading;
    // Whether the export has playlists, and whether a level of them is shown.
    in property <bool> has-playlists;
    in property <bool> in-playlists;
    // The column the list is sorted on (0 title, 1 artist, 2 BPM, 3 key, 4 time; -1 none),
    // and which way.
    in property <int> sort-column: -1;
    in property <bool> sort-descending;
    // Only tracks within 4 % of the reference deck's tempo, and that deck ("D1 128.0").
    in property <bool> bpm-filter;
    in property <string> bpm-reference;
    callback pick(int);
    callback load(int);
    callback playlists();
    // A column's heading tapped: sort on it, or turn its sort over.
    callback sort(int);
    callback bpm-filter-toggled();
    width: 952px;
    height: 474px;
    background: #000000;
    // Takes the taps that miss the rows and buttons, away from the page below.
    TouchArea { }
    // The column headings: a tap sorts on one (the title's is the level's name), and the
    // sorted one shows in yellow with its arrow, on a dark grey band with a rust line.
    Rectangle { x: 0px; y: 0px; width: 820px; height: 40px; background: #202020; }
    Rectangle { x: 0px; y: 40px; width: 820px; height: 2px; background: #e64c0c; }
    Text { x: 8px; y: 0px; height: 40px; text: "#"; color: #a3958e; font-size: 17px; vertical-alignment: center; }
    Text {
        x: 48px;
        y: 0px;
        width: 360px;
        height: 40px;
        text: root.heading + (root.sort-column == 0 ? (root.sort-descending ? "▼" : "▲") : "");
        color: root.sort-column == 0 ? #ffd600 : #a3958e;
        font-size: 17px;
        overflow: elide;
        vertical-alignment: center;
    }
    Text { x: 416px; y: 0px; height: 40px; text: "ARTIST" + (root.sort-column == 1 ? (root.sort-descending ? "▼" : "▲") : ""); color: root.sort-column == 1 ? #ffd600 : #a3958e; font-size: 17px; vertical-alignment: center; }
    Text { x: 622px; y: 0px; height: 40px; text: "BPM" + (root.sort-column == 2 ? (root.sort-descending ? "▼" : "▲") : ""); color: root.sort-column == 2 ? #ffd600 : #a3958e; font-size: 17px; vertical-alignment: center; }
    Text { x: 686px; y: 0px; height: 40px; text: "KEY" + (root.sort-column == 3 ? (root.sort-descending ? "▼" : "▲") : ""); color: root.sort-column == 3 ? #ffd600 : #a3958e; font-size: 17px; vertical-alignment: center; }
    Text { x: 732px; y: 0px; height: 40px; text: "TIME" + (root.sort-column == 4 ? (root.sort-descending ? "▼" : "▲") : ""); color: root.sort-column == 4 ? #ffd600 : #a3958e; font-size: 17px; vertical-alignment: center; }
    // Ten rows of 42 pixels on black, a grey line under each (the owner asked for larger
    // rows and text, 2026-11-26).
    for row[i] in root.rows: Rectangle {
        x: 0px;
        y: 44px + i * 43px;
        width: 820px;
        height: 42px;
        background: row.selected ? #0b2614 : #000000;
        border-width: row.selected ? 1px : 0px;
        border-color: #00ff66;
        if !row.selected: Rectangle { y: 42px; width: parent.width; height: 1px; background: #202020; }
        Text {
            x: 8px;
            width: 36px;
            text: row.number;
            color: #a3958e;
            font-size: 15px;
            vertical-alignment: center;
        }
        // A folder or playlist: a mark in its colour before the name.
        if row.kind != 0: Rectangle {
            x: 34px;
            y: 13px;
            width: 8px;
            height: 16px;
            border-radius: 2px;
            background: row.kind == 1 ? #ff7700 : #e64c0c;
        }
        Text {
            x: 48px;
            width: 360px;
            text: row.title;
            color: row.selected ? #00ff66 : #f5f0ed;
            font-size: 19px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 416px;
            width: 200px;
            text: row.artist;
            color: row.kind == 0 ? #f5f0ed : #a3958e;
            font-size: 17px;
            overflow: elide;
            vertical-alignment: center;
        }
        Text { x: 622px; width: 60px; text: row.bpm; color: #f5f0ed; font-size: 17px; vertical-alignment: center; }
        Text { x: 686px; width: 44px; text: row.key; color: row.fit == 1 ? #00ff66 : row.fit == 2 ? #ffd600 : row.fit == 3 ? #0088ff : row.fit == 4 ? #a3958e : #ff7700; font-size: 17px; vertical-alignment: center; }
        Text { x: 732px; width: 60px; text: row.time; color: #f5f0ed; font-size: 17px; vertical-alignment: center; }
        Text { x: 794px; width: 24px; text: row.decks; color: #e64c0c; font-size: 13px; vertical-alignment: center; }
        TouchArea {
            clicked => { root.pick(i); }
        }
    }
    // The right column, from the top (the owner's layout, 2026-11-26): LOAD D1 and D2, the
    // same size; PLAYLIST (in place of BACK, 2026-11-27); the BPM filter; then sorting by TRACK, ARTIST or BPM. Each as PLAY and
    // CUE: an outline in its colour, filled while held, or while it is on.
    for deck[i] in [1, 2]: Rectangle {
        property <color> tint: i == 0 ? #e64c0c : #00e5ff;
        x: 832px;
        y: i * 82px;
        width: 112px;
        height: 76px;
        border-radius: 4px;
        border-width: 2px;
        border-color: self.tint;
        background: load.pressed ? self.tint : #000000;
        Text {
            text: "LOAD\nD" + deck;
            color: load.pressed ? #100c08 : parent.tint;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        load := TouchArea {
            clicked => { root.load(i); }
        }
    }
    Rectangle {
        x: 832px;
        y: 164px;
        width: 112px;
        height: 48px;
        border-radius: 4px;
        border-width: 2px;
        // Green while a level of the playlists is shown, filled while held; grey with no
        // playlists.
        border-color: root.has-playlists ? (root.in-playlists ? #00ff66 : #a3958e) : #574b45;
        background: playlists.pressed ? #00ff66 : root.in-playlists ? #0b2614 : #000000;
        Text {
            text: "PLAYLIST";
            color: playlists.pressed ? #100c08 : root.has-playlists ? (root.in-playlists ? #00ff66 : #f5f0ed) : #574b45;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        playlists := TouchArea {
            enabled: root.has-playlists;
            clicked => { root.playlists(); }
        }
    }
    // The headings take a tap: the title's over the heading, then each column's.
    for column[i] in [{ x: 40px, w: 368px }, { x: 408px, w: 206px }, { x: 614px, w: 64px }, { x: 678px, w: 48px }, { x: 726px, w: 66px }]: TouchArea {
        x: column.x;
        y: 0px;
        width: column.w;
        height: 42px;
        clicked => { root.sort(i); }
    }
    Rectangle {
        x: 832px;
        y: 218px;
        width: 112px;
        height: 60px;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.bpm-filter ? #e64c0c : #574b45;
        background: root.bpm-filter || bpm.pressed ? #e64c0c : #000000;
        Text { y: 8px; width: parent.width; text: "BPM ±4%"; color: root.bpm-filter || bpm.pressed ? #100c08 : #f5f0ed; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
        Text { y: 34px; width: parent.width; text: root.bpm-reference; color: root.bpm-filter || bpm.pressed ? #100c08 : #a3958e; font-size: 13px; horizontal-alignment: center; }
        bpm := TouchArea {
            clicked => { root.bpm-filter-toggled(); }
        }
    }
    // Sorting, as the headings do: a tap sorts on the column, a second turns it over. The
    // one in use is filled yellow, with its direction.
    for button[i] in [{ text: "TRACK", column: 0 }, { text: "ARTIST", column: 1 }, { text: "BPM", column: 2 }]: Rectangle {
        property <bool> on: root.sort-column == button.column;
        x: 832px;
        y: 290px + i * 50px;
        width: 112px;
        height: 44px;
        border-radius: 4px;
        border-width: 2px;
        border-color: self.on ? #ffd600 : #574b45;
        background: self.on || sort-touch.pressed ? #ffd600 : #000000;
        Text {
            text: button.text + (parent.on ? (root.sort-descending ? " ▼" : " ▲") : "");
            color: parent.on || sort-touch.pressed ? #100c08 : #a3958e;
            font-size: 17px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        sort-touch := TouchArea {
            clicked => { root.sort(button.column); }
        }
    }
    Text {
        x: 832px;
        y: 446px;
        width: 112px;
        text: root.count;
        color: #a3958e;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

// A choice on the FX page: an outline, filled with its tint while it is the one in use.
component FxChoice inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <color> tint;
    // The text's colour while not in use.
    in property <color> ink: #a3958e;
    callback clicked();
    height: 56px;
    border-radius: 6px;
    border-width: 2px;
    border-color: root.selected ? root.tint : #38251e;
    background: root.selected ? root.tint : touch.pressed ? #202020 : #000000;
    Text {
        text: root.text;
        color: root.selected ? #000000 : root.ink;
        font-size: 19px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Beat FX by touch: the effect, its beat and channel, the depth, and FX ON. Each choice
// does what the controller's Beat FX buttons and knob do. The effect's colour (as on the
// FX panel) runs through the page: its button, the beat chosen and the depth (the owner
// asked for a clearer page, 2026-11-26).
component FxPage inherits Rectangle {
    in property <string> effect;
    in property <string> beat;
    in property <int> depth;
    in property <int> target;
    in property <bool> on;
    // What changed (0 effect, 1 beat, 2 channel, 3 depth from 0 to 127, 4 FX ON) and to.
    callback set(int, float);
    callback close();
    property <color> accent: root.effect == "ECHO" ? #eb870f
        : root.effect == "FLANGER" ? #b44ae0
        : root.effect == "DELAY" ? #27c7c7
        : #2d85cd;
    width: 952px;
    height: 474px;
    background: #000000;
    // Takes the taps that miss the buttons, away from the page below.
    TouchArea { }
    Text { x: 16px; y: 10px; text: "BEAT FX"; color: #f5f0ed; font-size: 22px; font-weight: 700; }
    Text { x: 130px; y: 15px; text: root.effect; color: root.accent; font-size: 17px; font-weight: 700; }
    FxChoice {
        x: 812px;
        y: 8px;
        width: 132px;
        height: 44px;
        text: "CLOSE";
        tint: #574b45;
        clicked => { root.close(); }
    }
    Text { x: 16px; y: 60px; text: "EFFECT"; color: #a3958e; font-size: 13px; }
    for item[i] in [
        { name: "FILTER", tint: #2d85cd },
        { name: "ECHO", tint: #eb870f },
        { name: "FLANGER", tint: #b44ae0 },
        { name: "DELAY", tint: #27c7c7 },
    ]: FxChoice {
        x: 16px + i * 198px;
        y: 80px;
        width: 190px;
        height: 60px;
        text: item.name;
        tint: item.tint;
        ink: item.tint;
        border-color: self.selected ? item.tint : item.tint.darker(60%);
        selected: item.name == root.effect;
        clicked => { root.set(0, i); }
    }
    Text { x: 16px; y: 156px; text: "BEAT"; color: #a3958e; font-size: 13px; }
    for name[i] in ["1/4", "1/2", "1", "2", "4"]: FxChoice {
        x: 16px + i * 158px;
        y: 176px;
        width: 150px;
        text: name;
        tint: root.accent;
        selected: name == root.beat;
        clicked => { root.set(1, i); }
    }
    Text { x: 16px; y: 248px; text: "CHANNEL"; color: #a3958e; font-size: 13px; }
    for item[i] in [
        { name: "DECK 1", tint: #e64c0c },
        { name: "DECK 2", tint: #00e5ff },
        { name: "BOTH", tint: #f5f0ed },
    ]: FxChoice {
        x: 16px + i * 198px;
        y: 268px;
        width: 190px;
        text: item.name;
        tint: item.tint;
        ink: item.tint;
        // Deck 1, deck 2 and both are channels 1, 2 and 0.
        selected: Math.mod(i + 1, 3) == root.target;
        clicked => { root.set(2, Math.mod(i + 1, 3)); }
    }
    Text { x: 16px; y: 340px; text: "DEPTH"; color: #a3958e; font-size: 13px; }
    Rectangle {
        x: 16px;
        y: 360px;
        width: 690px;
        height: 60px;
        border-radius: 6px;
        border-width: 2px;
        border-color: #38251e;
        background: #000000;
        Rectangle {
            x: 2px;
            y: 2px;
            width: (parent.width - 4px) * root.depth / 100;
            height: parent.height - 4px;
            border-radius: 4px;
            background: root.accent;
        }
        // Down on the bar and dragged along it, as the depth knob turns.
        slide := TouchArea {
            changed pressed => {
                if (self.pressed) {
                    root.set(3, max(0, min(1, self.mouse-x / self.width)) * 127);
                }
            }
            moved => { root.set(3, max(0, min(1, self.mouse-x / self.width)) * 127); }
        }
    }
    Text {
        x: 712px;
        y: 360px;
        width: 92px;
        height: 60px;
        text: root.depth + "%";
        color: root.accent;
        font-size: 26px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // FX ON: filled green while on, a green outline while off.
    Rectangle {
        x: 812px;
        y: 80px;
        width: 132px;
        height: 340px;
        border-radius: 8px;
        border-width: 2px;
        border-color: #00ff66;
        background: root.on ? #00ff66 : toggle.pressed ? #0b2614 : #000000;
        Text {
            text: root.on ? "FX ON" : "FX OFF";
            color: root.on ? #000000 : #00ff66;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        toggle := TouchArea {
            clicked => { root.set(4, 0); }
        }
    }
}

// The Beat FX at a glance, right of the lanes; a tap opens the FX page.
component FxPanel inherits Rectangle {
    in property <string> effect;
    in property <string> beat;
    in property <int> depth;
    in property <int> target;
    in property <bool> on;
    callback open();
    width: 64px;
    height: 424px;
    // Black, as the rail and the deck cards (the owner asked, 2026-11-26).
    background: #000000;
    border-width: 1px;
    // Each effect has its colour, as on the donor's overview (`ui_overview_fx_effect_color`):
    // FILTER blue, ECHO amber, FLANGER violet, DELAY teal. While the effect is on, the
    // panel's edge, the FX label, the effect, the routed channels, the beat and the depth
    // take it; off, they stay dim.
    property <color> tint: root.effect == "ECHO" ? #eb870f
        : root.effect == "FLANGER" ? #b44ae0
        : root.effect == "DELAY" ? #27c7c7
        : #2d85cd;
    border-color: root.on ? root.tint : #38251e;
    TouchArea {
        clicked => { root.open(); }
    }
    // While the effect is on, the FX label blinks in its colour.
    property <bool> lit;
    Timer {
        interval: 400ms;
        running: root.on;
        triggered => { root.lit = !root.lit; }
    }
    Rectangle {
        x: 4px;
        y: 4px;
        width: 56px;
        height: 22px;
        background: !root.on ? #1e1511 : root.lit ? root.tint : root.tint.darker(70%);
        Text { text: "FX"; color: root.on && root.lit ? #100c08 : #f5f0ed; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: 4px;
        y: 30px;
        width: 56px;
        height: 34px;
        border-width: 1px;
        border-color: root.on ? root.tint : #574b45;
        background: root.on ? root.tint : transparent;
        Text { text: root.effect; color: root.on ? #100c08 : #a3958e; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 68px; width: 64px; text: "TARGET"; color: #a3958e; font-size: 11px; horizontal-alignment: center; }
    for pill in 2: Rectangle {
        x: 5px + pill * 29px;
        y: 84px;
        width: 25px;
        height: 22px;
        border-radius: 11px;
        border-width: 1px;
        property <bool> routed: root.on && (root.target == 0 || root.target == pill + 1);
        border-color: self.routed ? root.tint : #574b45;
        background: self.routed ? root.tint : #000000;
        Text { text: pill + 1; color: parent.routed ? #100c08 : #a3958e; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 112px; width: 64px; text: "BEAT"; color: #a3958e; font-size: 11px; horizontal-alignment: center; }
    Rectangle {
        x: 12px;
        y: 128px;
        width: 40px;
        height: 26px;
        border-width: 1px;
        border-color: root.on ? root.tint : #574b45;
        Text { text: root.beat; color: root.on ? #f5f0ed : #a3958e; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 0px; y: 160px; width: 64px; text: "DEPTH"; color: #a3958e; font-size: 11px; horizontal-alignment: center; }
    Rectangle {
        x: 22px;
        y: 176px;
        width: 20px;
        height: parent.height - 212px;
        border-width: 1px;
        border-color: #574b45;
        Rectangle {
            x: 1px;
            y: parent.height - 1px - self.height;
            width: 18px;
            height: (parent.height - 2px) * root.depth / 100;
            background: root.on ? root.tint : #574b45;
        }
    }
    Text { x: 0px; y: parent.height - 30px; width: 64px; text: root.depth + "%"; color: #f5f0ed; font-size: 14px; horizontal-alignment: center; }
}

export component Overview inherits Window {
    width: 1024px;
    height: 600px;
    default-font-family: "DejaVu Sans";
    background: #000000;
    in property <string> title-1;
    in property <string> title-2;
    in property <string> elapsed-1;
    in property <string> elapsed-2;
    in property <string> remaining-1;
    in property <string> remaining-2;
    // A deck in its track's last 30 s: its time left blinks red, lit while `blink` is.
    in property <bool> ending-1;
    in property <bool> ending-2;
    in property <bool> blink;
    in property <string> bpm-1;
    in property <string> bpm-2;
    in property <string> pitch-1;
    in property <string> pitch-2;
    in property <string> key-1;
    in property <string> key-2;
    in property <string> status-1;
    in property <string> status-2;
    in property <bool> master-tempo-1;
    in property <bool> master-tempo-2;
    in property <bool> quantize-1;
    in property <bool> quantize-2;
    in property <bool> playing-1;
    in property <bool> playing-2;
    in property <image> cover-1;
    in property <image> cover-2;
    in property <bool> has-cover-1;
    in property <bool> has-cover-2;
    in property <string> fx-effect;
    in property <string> fx-beat;
    in property <int> fx-depth;
    in property <int> fx-target;
    in property <bool> fx-on;

    in property <[LibraryLine]> library-rows;
    in property <string> library-count;
    in property <string> library-heading;
    in property <bool> library-has-playlists;
    in property <bool> library-in-playlists;
    in property <int> library-sort-column: -1;
    in property <bool> library-sort-descending;
    in property <bool> library-bpm-filter;
    in property <string> library-bpm-reference;
    in property <[CueTile]> cues-1;
    in property <[CueTile]> cues-2;
    in property <[MemoryLine]> memory-1;
    in property <[MemoryLine]> memory-2;
    in property <bool> loaded-1;
    in property <bool> loaded-2;
    in property <[SettingLine]> settings-left;
    in property <[SettingLine]> settings-right;
    in property <bool> setting-load-lock: true;
    in property <bool> setting-jog-cdj-1;
    in property <bool> setting-jog-cdj-2;
    in property <int> setting-backlight: 25;
    in property <int> setting-trim;
    in property <int> setting-screensaver: 1;
    in property <bool> setting-wifi: false;
    // Over everything: 0 nothing, 1 the boot screen, 2 the screensaver, 3 a firmware
    // update being written (`screen_idle.rs`).
    in property <int> cover: 1;
    // The shine's centre on the boot screen and screensaver, in pixels from the word's left
    // edge; it slides across the word and rests off it (-1000) between sweeps.
    in property <int> cover-shine: -1000;
    // The screensaver's saying, 0 to 2: it changes every minute.
    in property <int> cover-quote;
    // How far the other deck's beat is ahead of the master's ("+12 ms"), or a dash.
    in property <string> phase: "—";

    // Deck 0 or 1: PLAY pressed, CUE down or up.
    callback play(int);
    callback cue(int, bool);
    // The Library: a row of the page tapped, LOAD tapped for deck 0 or 1, PLAYLIST tapped.
    callback pick(int);
    callback load(int);
    callback library-playlists();
    // The Library's column heading 0 to 4 tapped, and its BPM filter.
    callback library-sort(int);
    callback library-bpm-filter-toggled();
    // The Hot Cues page: deck 0 or 1, its pad 0 to 7 down or up, and whether it deletes.
    callback hot-cue(int, int, bool, bool);
    // The Hot Cues page's MEMORY list: deck 0 or 1, its memory cue 0 to 15 tapped.
    callback memory-cue(int, int);
    // The FX page: what changed (0 effect, 1 beat, 2 channel, 3 depth, 4 FX ON) and to.
    callback fx(int, float);
    // MT tapped on deck 0 or 1.
    callback master-tempo(int);
    // The Settings page: what changed (0 LOAD LOCK, 1 and 2 a deck's jog, 3 the
    // brightness one step, 4 the MAIN trim, 5 the screensaver) and to.
    callback setting(int, int);
    // Each tab has a page. The FX panel opens page 4, which no tab marks.
    in-out property <int> active-tab: 0;

    // The pages, on a rail at the left: icons only, on black.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 48px;
        height: 600px;
        background: #000000;
        Rectangle { x: 47px; width: 1px; height: 600px; background: #38251e; }
        RailButton {
            y: 0px;
            icon: @image-url("icons/overview.png");
            active: root.active-tab == 0;
            clicked => { root.active-tab = 0; }
        }
        RailButton {
            y: 120px;
            icon: @image-url("icons/library.png");
            active: root.active-tab == 1;
            clicked => { root.active-tab = 1; }
        }
        RailButton {
            y: 240px;
            icon: @image-url("icons/cues.png");
            active: root.active-tab == 2;
            clicked => { root.active-tab = 2; }
        }
        RailButton {
            y: 360px;
            icon: @image-url("icons/fx.png");
            active: root.active-tab == 4;
            clicked => { root.active-tab = 4; }
        }
        RailButton {
            y: 480px;
            icon: @image-url("icons/settings.png");
            active: root.active-tab == 3;
            clicked => { root.active-tab = 3; }
        }
    }

    // The decks, waveforms and FX panel lie under every other page, which covers them
    // whole: hidden there, so that Slint does not draw them only to draw over them.
    DeckSide {
        visible: root.active-tab == 0;
        x: 52px;
        y: 8px;
        number: 1;
        accent: #e64c0c;
        playing: root.playing-1;
        cover: root.cover-1;
        has-cover: root.has-cover-1;
        play => { root.play(0); }
        cue(down) => { root.cue(0, down); }
    }
    DeckSide {
        visible: root.active-tab == 0;
        x: 52px;
        y: 232px;
        number: 2;
        accent: #00e5ff;
        playing: root.playing-2;
        cover: root.cover-2;
        has-cover: root.has-cover-2;
        play => { root.play(1); }
        cue(down) => { root.cue(1, down); }
    }
    // Rust draws here: the two waveforms.
    Rectangle { visible: root.active-tab == 0; x: 129px; y: 8px; width: 814px; height: 200px; background: #000000; }
    Rectangle { visible: root.active-tab == 0; x: 129px; y: 232px; width: 814px; height: 200px; background: #000000; }
    // Between the lanes: the phase strip, which Rust draws, and its offset. At 24 px there
    // is room for one line: the offset alone.
    Rectangle {
        visible: root.active-tab == 0;
        x: 52px;
        y: 208px;
        width: 74px;
        height: 24px;
        border-radius: 3px;
        background: #202020;
        Text { y: 3px; width: parent.width; text: root.phase; color: root.phase == "—" ? #574b45 : #ffd600; font-size: 14px; horizontal-alignment: center; }
    }
    Rectangle { visible: root.active-tab == 0; x: 129px; y: 208px; width: 814px; height: 24px; background: #202020; }

    FxPanel {
        visible: root.active-tab == 0;
        x: 956px;
        y: 8px;
        effect: root.fx-effect;
        beat: root.fx-beat;
        depth: root.fx-depth;
        target: root.fx-target;
        on: root.fx-on;
        open => { root.active-tab = 4; }
    }

    // Made once and kept: opening the page then only draws it.
    LibraryPage {
        visible: root.active-tab == 1;
        x: 48px;
        y: 0px;
        rows: root.library-rows;
        count: root.library-count;
        heading: root.library-heading;
        has-playlists: root.library-has-playlists;
        in-playlists: root.library-in-playlists;
        sort-column: root.library-sort-column;
        sort-descending: root.library-sort-descending;
        bpm-filter: root.library-bpm-filter;
        bpm-reference: root.library-bpm-reference;
        pick(row) => { root.pick(row); }
        load(deck) => { root.load(deck); }
        playlists => { root.library-playlists(); }
        sort(column) => { root.library-sort(column); }
        bpm-filter-toggled => { root.library-bpm-filter-toggled(); }
    }

    if root.active-tab == 4: FxPage {
        x: 48px;
        y: 0px;
        effect: root.fx-effect;
        beat: root.fx-beat;
        depth: root.fx-depth;
        target: root.fx-target;
        on: root.fx-on;
        set(kind, value) => { root.fx(kind, value); }
        close => { root.active-tab = 0; }
    }

    if root.active-tab == 3: SettingsPage {
        x: 48px;
        y: 0px;
        left: root.settings-left;
        right: root.settings-right;
        load-lock: root.setting-load-lock;
        jog-cdj-1: root.setting-jog-cdj-1;
        jog-cdj-2: root.setting-jog-cdj-2;
        backlight: root.setting-backlight;
        trim: root.setting-trim;
        screensaver: root.setting-screensaver;
        wifi: root.setting-wifi;
        change(kind, value) => { root.setting(kind, value); }
    }

    if root.active-tab == 2: Rectangle {
        x: 48px;
        y: 0px;
        width: 952px;
        height: 474px;
        background: #000000;
        // Takes the taps that miss the pads and buttons, away from the page below.
        TouchArea { }
        CueDeck {
            x: 0px;
            number: 1;
            accent: #e64c0c;
            title: root.title-1;
            loaded: root.loaded-1;
            tiles: root.cues-1;
            memory: root.memory-1;
            pad(pad, down, delete) => { root.hot-cue(0, pad, down, delete); }
            call(n) => { root.memory-cue(0, n); }
        }
        Rectangle { x: 475px; y: 8px; width: 2px; height: 458px; background: #38251e; }
        CueDeck {
            x: 476px;
            number: 2;
            accent: #00e5ff;
            title: root.title-2;
            loaded: root.loaded-2;
            tiles: root.cues-2;
            memory: root.memory-2;
            pad(pad, down, delete) => { root.hot-cue(1, pad, down, delete); }
            call(n) => { root.memory-cue(1, n); }
        }
    }

    // The deck cards, on every page: title, times and tempo, and the overview. On the
    // overview page they are taller, with an overview of 80 pixels (45 on the others,
    // whose pages need the height): the owner asked for larger overviews (2026-11-26).
    for deck in 2: Rectangle {
        x: 52px + deck * 486px;
        y: root.active-tab == 0 ? 438px : 478px;
        width: 482px;
        height: root.active-tab == 0 ? 156px : 116px;
        border-radius: 3px;
        border-width: 1px;
        border-color: #38251e;
        background: #000000;
        Rectangle { x: 7px; y: 8px; width: 6px; height: 22px; background: deck == 0 ? #e64c0c : #00e5ff; }
        Text {
            x: 21px;
            y: 6px;
            width: 352px;
            height: 26px;
            text: deck == 0 ? root.title-1 : root.title-2;
            color: #f5f0ed;
            font-size: 18px;
            overflow: elide;
            vertical-alignment: center;
        }
        // The key and the deck's state, as tags at the title's end.
        property <string> key: deck == 0 ? root.key-1 : root.key-2;
        property <string> status: deck == 0 ? root.status-1 : root.status-2;
        // The key above Q, green as PAUSE; the state beside it.
        if key != "": Tag {
            x: 429px;
            y: 8px;
            width: 44px;
            text: key;
            tint: #00ff66;
        }
        if status != "": Tag {
            x: 379px;
            y: 8px;
            width: 46px;
            text: status;
            tint: status == "SYNC" ? (deck == 0 ? #e64c0c : #00e5ff) : status == "LOOP" ? #ff7700 : #574b45;
        }
        // Rust draws the overview here.
        Rectangle {
            x: 8px;
            y: root.active-tab == 0 ? 72px : 70px;
            width: 466px;
            height: root.active-tab == 0 ? 80px : 45px;
            background: #000000;
        }
    }
    DeckInfo {
        x: 59px;
        y: root.active-tab == 0 ? 473px : 513px;
        elapsed: root.elapsed-1;
        remaining: root.remaining-1;
        ending: root.ending-1;
        blink: root.blink;
        bpm: root.bpm-1;
        pitch: root.pitch-1;
        master-tempo: root.master-tempo-1;
        quantize: root.quantize-1;
        mt-tapped => { root.master-tempo(0); }
    }
    DeckInfo {
        x: 545px;
        y: root.active-tab == 0 ? 473px : 513px;
        elapsed: root.elapsed-2;
        remaining: root.remaining-2;
        ending: root.ending-2;
        blink: root.blink;
        bpm: root.bpm-2;
        pitch: root.pitch-2;
        master-tempo: root.master-tempo-2;
        quantize: root.quantize-2;
        mt-tapped => { root.master-tempo(1); }
    }

    // Track titles and artists use more than ASCII. The software renderer only has
    // the glyphs it embedded at build time: ASCII, plus every character in a string
    // literal. This invisible text puts Latin-1, Latin Extended-A (with the Croatian
    // letters) and typographic quotes and dashes into every embedded size.
    Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        color: transparent;
        text: "¡¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĨĩĪīĬĭĮįİıĲĳĴĵĶķĸĹĺĻļĽľĿŀŁłŃńŅņŇňŉŊŋŌōŎŏŐőŒœŔŕŖŗŘřŚśŜŝŞşŠšŢţŤťŦŧŨũŪūŬŭŮůŰűŲųŴŵŶŷŸŹźŻżŽžſ‘’‚“”„–—•€™▲▼";
    }

    // The boot screen and the screensaver: the owner's RUZINA wordmark, with a shine that
    // slides across it. The screensaver is on black, with a saying under the word.
    if root.cover != 0: Rectangle {
        width: 1024px;
        height: 600px;
        background: #000000;
        // Takes every tap: one that wakes the screensaver presses nothing below.
        TouchArea { }
        // The wordmark cut into its letters (`wordmark/make.sh`), side by side as drawn.
        HorizontalLayout {
            y: 244px;
            height: 112px;
            alignment: center;
            spacing: 0px;
            for letter[i] in [
                @image-url("wordmark/R.png"),
                @image-url("wordmark/U.png"),
                @image-url("wordmark/Z.png"),
                @image-url("wordmark/I.png"),
                @image-url("wordmark/N.png"),
                @image-url("wordmark/A.png"),
            ]: Image {
                source: letter;
                // A little dimmed, so the shine shows; steady under UPDATING FIRMWARE.
                opacity: root.cover == 3 ? 1.0 : 0.75;
            }
        }
        // The shine: the word brightened (`wordmark/shine.py`), seen through a band that
        // slides across it. Three bands, wide to narrow, each adding some of it, make the
        // band's edges soft. The word is 720 px wide, from x 152.
        for band in [120, 80, 40]: Rectangle {
            visible: root.cover-shine > -500;
            x: (152 + root.cover-shine - band / 2) * 1px;
            y: 244px;
            width: band * 1px;
            height: 112px;
            clip: true;
            opacity: 0.4;
            Image {
                x: (band / 2 - root.cover-shine) * 1px;
                source: @image-url("wordmark/word-shine.png");
            }
        }
        // The owner's sayings, one a minute.
        if root.cover == 2: Text {
            y: 468px;
            width: 1024px;
            text: root.cover-quote == 0 ? "“Without music, life would be a mistake.”"
                : root.cover-quote == 1 ? "“Music is liquid architecture; architecture is frozen music.”"
                : "“Techno is everything you haven't imagined yet.”";
            color: #a3958e;
            font-size: 22px;
            horizontal-alignment: center;
        }
        if root.cover == 2: Text {
            y: 506px;
            width: 1024px;
            text: root.cover-quote == 0 ? "- Friedrich Nietzsche -"
                : root.cover-quote == 1 ? "- Goethe -"
                : "- Jeff Mills -";
            color: #b7410e;
            font-size: 16px;
            horizontal-alignment: center;
        }
        if root.cover == 3: Text {
            y: 420px;
            width: 1024px;
            text: "UPDATING FIRMWARE";
            color: #ff0033;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if root.cover == 3: Text {
            y: 470px;
            width: 1024px;
            text: "Keep the deck switched on. It restarts when the update is in.";
            color: #a3958e;
            font-size: 18px;
            horizontal-alignment: center;
        }
    }
}
