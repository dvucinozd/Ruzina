config RUZINA_MEMORY_TASK
    bool "Isolated legacy memory/task experiment"
    default n

config RUZINA_DISPLAY_TOUCH
    bool "Isolated JC1060 New_Panel display/touch diagnostic"
    default n

config RUZINA_SD_READONLY
    bool "Isolated read-only SD/exFAT diagnostic"
    default n

config RUZINA_SD_FIXTURE
    bool "Verify deterministic read-only file/seek fixture repeatedly"
    depends on RUZINA_SD_READONLY
    default n

config RUZINA_SD_RUST_BRIDGE
    bool "Isolated IDF-owned SD transport for shared Rust block client"
    default n

config RUZINA_SD_RUST_EXFAT
    bool "Verify fixture through shared Rust partition/exFAT reader"
    depends on RUZINA_SD_RUST_BRIDGE
    default n

config RUZINA_SD_RUST_LOAD
    bool "Import export.pdb and preflight every track through shared Rust media load"
    depends on RUZINA_SD_RUST_BRIDGE && SPIRAM && !RUZINA_SD_RUST_EXFAT
    default n

config RUZINA_USB_HOST_ENUM
    bool "Isolated USB host enumeration diagnostic on the HS port"
    default n

config RUZINA_USB_HOST_MIDI
    bool "Claim the USB-MIDI interface and feed the Rust controller session"
    depends on RUZINA_USB_HOST_ENUM
    default n

config RUZINA_LOAD_DISPLAY
    bool "Show the media load status on the New_Panel, with touch track selection"
    depends on RUZINA_SD_RUST_LOAD && !RUZINA_DISPLAY_TOUCH
    default n
